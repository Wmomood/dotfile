 /* wallust template - colors-rofi */

* {
active-background: #737D7E;
active-foreground: #E5EBEC;
normal-background: #1F1F1F;
normal-foreground: #E5EBEC;
urgent-background: #ACBBBE;
urgent-foreground: #E5EBEC;

alternate-active-background: #53646D;
alternate-active-foreground: #E5EBEC;
alternate-normal-background: #1F1F1F;
alternate-normal-foreground: #E5EBEC;
alternate-urgent-background: #1F1F1F;
alternate-urgent-foreground: #E5EBEC;

selected-active-background: #ACBBBE;
selected-active-foreground: #E5EBEC;
selected-normal-background: #ACBBBE;
selected-normal-foreground: #E5EBEC;
selected-urgent-background: #737D7E;
selected-urgent-foreground: #E5EBEC;

background-color: #1F1F1F;
background: rgba(0,0,0,0.7);
foreground: #E5EBEC;
border-color: #737D7E;

color0: #454645;
color1: #161816;
color2: #323736;
color3: #3E4B51;
color4: #565E5E;
color5: #818C8F;
color6: #889497;
color7: #D2DADC;
color8: #93989A;
color9: #1D201D;
color10: #434948;
color11: #53646D;
color12: #737D7E;
color13: #ACBBBE;
color14: #B6C5C9;
color15: #D2DADC;


}

